<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ENSPY" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/enspy_orange_dark</item>
        <item name="android:navigationBarColor">@color/enspy_cream</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/enspy_cream</item>
        <item name="colorPrimary">@color/enspy_orange</item>
        <item name="colorSecondary">@color/enspy_orange_dark</item>
        <!-- Ensure Material components pick up the theme -->
        <item name="materialButtonStyle">@style/Widget.Enspy.MaterialButton</item>
    </style>

    <style name="Theme.ENSPY" parent="Base.Theme.ENSPY" />

    <style name="Widget.Enspy.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
