<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography using downloadable Poppins -->
    <style name="Enspy.TextAppearance.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Enspy.TextAppearance.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Enspy.TextAppearance.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Material button styles -->
    <style name="Widget.Enspy.ContainedButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.Enspy.OutlinedButton" parent="Widget.Material3.OutlinedButton">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Card style -->
    <style name="Widget.Enspy.Card" parent="Widget.Material3.Card">
        <item name="android:cardCornerRadius">12dp</item>
        <item name="android:cardElevation">4dp</item>
    </style>

</resources>
